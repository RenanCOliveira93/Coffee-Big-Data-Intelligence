# Copie para .env (não versione)
# UFs (códigos IBGE, separados por vírgula) a ingerir. 35 = SP. Ex. expansão: 35,31,32,41
COFFEE_UFS=35
# Janela climática (NASA POWER, diário)
POWER_START_YEAR=2000
POWER_END_YEAR=2025
# Reingerir sempre os N últimos anos do PAM (o IBGE revisa dados recentes)
PAM_REFRESH_RECENT_YEARS=2
# Início da série PAM "total" (café sem separar espécie existe desde 1974)
PAM_START_YEAR=1974
# Benchmark: limites de recursos
BENCH_THREADS=4
BENCH_MEM_GB=8
# JAVA_HOME para PySpark (se vazio, usa .tools/jdk local ou o Java do sistema)
JAVA_HOME=
# MLflow opcional (1 = registra experimentos em ./mlflow.db, SQLite)
USE_MLFLOW=0
